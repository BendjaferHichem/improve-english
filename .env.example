# ---- Supabase (Project Settings -> API) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The "anon" / public key. Safe to expose: Row Level Security protects the data.
# Never put the service_role key here.
SUPABASE_ANON_KEY=

# ---- LLM provider (server-side only; never sent to the browser) ----
# "gemini", "groq", "openrouter", or "openai-compatible" (any other OpenAI-style API, needs AI_BASE_URL)
AI_PROVIDER=
AI_API_KEY=
# Free-tier model lineups change. Check https://aistudio.google.com for a current
# Flash / Flash-Lite model id. If you get "AI model isn't available", change this.
AI_MODEL=
# Only for AI_PROVIDER=openai-compatible, e.g. https://api.groq.com/openai/v1
# AI_BASE_URL=
# Optional, Gemini 2.5 Flash only: 0 turns "thinking" off for lower latency.
# Leave unset if your model rejects it.
# AI_GEMINI_THINKING_BUDGET=0

# ---- Local dev only ----
PORT=3000
